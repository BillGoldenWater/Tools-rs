Cb * Cb.a + Ca * (Ca.a - Cb.a) = Cr

Cb * Cb.a + 1 * (1 - Cb.a)     = Cr.1
Cb * Cb.a + 1 - Cb.a           = Cr.1
Cb * Cb.a + 1 - Cb.a           = Cr.1

Cb * Cb.a + 0 * (1 - Cb.a)     = Cr.2
Cb * Cb.a                      = Cr.2

# Cr.1 >= 0.5, Cr.1 < 1
Cb * Cb.a + 1 - Cb.a           = Cr.1
Cb                             = (Cr.1 + Cb.a - 1) / Cb.a

# Cr.2 < 0.5,  Cr.2 >= 0
Cb * Cb.a                      = Cr.2
Cb                             = Cr.2 / Cb.a

(Cr.1 + Cb.a - 1) / Cb.a       = Cr.2 / Cb.a
Cr.1 + Cb.a - 1                = Cr.2
Cr.1 + Cb.a                    = Cr.2 + 1
Cb.a                           = Cr.2 + 1 - Cr.1

